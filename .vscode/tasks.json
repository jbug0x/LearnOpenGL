{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL (g++)",
            "type": "process",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/Header",
                "-I${workspaceFolder}/libraries/include",
                "${workspaceFolder}/Source/main.cpp",
                "${workspaceFolder}/Source/Shader.cpp",
                "${workspaceFolder}/Source/glad.c",
                "-L${workspaceFolder}/libraries/lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-luser32",
                "-lshell32",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
